{
  "name": "vizmo-demo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:tokens": "! grep -rnE '#[0-9a-fA-F]{3,8}\\b|rgba?\\(' src --include='*.ts' --include='*.tsx' --include='*.css' --exclude=tokens.css",
    "verify": "npm run lint && npm run typecheck && npm run check:tokens && npm run build"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
